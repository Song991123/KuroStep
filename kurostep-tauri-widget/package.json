{
  "name": "kurostep-tauri-widget",
  "version": "0.1.36",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tauri dev",
    "build": "tauri build",
    "tauri": "tauri",
    "dev:react": "vite --host 127.0.0.1",
    "build:react": "vite build",
    "build:desktop-assets": "KUROSTEP_DESKTOP_BUILD=1 vite build && rm -rf dist-react/assets-local && cp src/lyrics.html src/lyrics.css src/lyrics.js dist-react/ && cp -R src/assets dist-react/assets-local",
    "qa:logic": "node --experimental-strip-types scripts/qa-logic-check.ts",
    "qa:korean-live": "node --experimental-strip-types scripts/qa-korean-live.ts",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.0.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "typescript": "^6.0.3",
    "vite": "^8.0.16"
  },
  "dependencies": {
    "lucide-react": "^1.17.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  }
}
