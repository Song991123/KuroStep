{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "KuroStep",
  "version": "0.1.0",
  "identifier": "com.song991123.kurostep",
  "build": {
    "beforeDevCommand": "",
    "beforeBuildCommand": "",
    "frontendDist": "../src"
  },
  "app": {
    "macOSPrivateApi": true,
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "KuroStep",
        "url": "shell.html?view=main",
        "width": 380,
        "height": 660,
        "minWidth": 360,
        "minHeight": 620,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "center": true,
        "shadow": true
      },
      {
        "label": "lyrics",
        "title": "KuroStep Lyrics",
        "url": "lyrics.html",
        "width": 760,
        "height": 128,
        "minWidth": 420,
        "minHeight": 96,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": false,
        "center": true,
        "shadow": false
      },
      {
        "label": "paw",
        "title": "KuroStep Paw Notes",
        "url": "shell.html?view=paw",
        "width": 380,
        "height": 520,
        "minWidth": 360,
        "minHeight": 440,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": false,
        "center": true,
        "shadow": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "app",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns"
    ]
  }
}
