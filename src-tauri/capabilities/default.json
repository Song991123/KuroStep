{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Default permissions for the KuroStep desktop widget",
  "windows": ["main", "lyrics"],
  "remote": {
    "urls": ["https://song991123.github.io/KuroStep/"]
  },
  "permissions": [
    "core:default",
    "core:window:allow-close",
    "core:window:allow-minimize",
    "core:window:allow-start-dragging",
    "core:window:allow-toggle-maximize"
  ]
}
