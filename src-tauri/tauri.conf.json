{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "KuroStep Widget",
  "version": "0.1.0",
  "identifier": "dev.local.kurostep-widget",
  "build": {
    "beforeDevCommand": "",
    "beforeBuildCommand": "",
    "frontendDist": "../src"
  },
  "app": {
    "macOSPrivateApi": true,
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "KuroStep Widget",
        "url": "https://song991123.github.io/KuroStep/",
        "width": 380,
        "height": 660,
        "minWidth": 360,
        "minHeight": 620,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "center": true,
        "shadow": true
      },
      {
        "label": "lyrics",
        "title": "KuroStep Lyrics",
        "url": "lyrics.html",
        "width": 760,
        "height": 128,
        "minWidth": 420,
        "minHeight": 96,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": false,
        "center": true,
        "shadow": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "app",
    "icon": ["icons/icon.png"]
  }
}
