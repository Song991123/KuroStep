{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Tauri Widget Smoke",
  "version": "0.1.0",
  "identifier": "dev.local.tauri-widget-smoke",
  "build": {
    "beforeDevCommand": "",
    "beforeBuildCommand": "",
    "frontendDist": "../app"
  },
  "app": {
    "macOSPrivateApi": true,
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Tauri Widget Smoke",
        "width": 380,
        "height": 660,
        "minWidth": 360,
        "minHeight": 620,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "center": true,
        "shadow": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "app",
    "icon": []
  }
}
